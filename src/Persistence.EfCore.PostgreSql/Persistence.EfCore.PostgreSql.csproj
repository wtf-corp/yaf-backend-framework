<Project Sdk="Microsoft.NET.Sdk">

  <!-- Empty until the Npgsql setup and snake_case naming arrive (specs/0013-thin-slice/plan.md, T39). No IsAotCompatible or IsTrimmable:
       native AOT is a non-goal while persistence depends on EF Core (01 §4). -->
  <PropertyGroup>
    <YafServiceCode>core</YafServiceCode>
  </PropertyGroup>

  <!-- Npgsql's EF Core provider, as ADR-0003's row for YAF.Persistence.EfCore and .PostgreSql allows
       (specs/0013-thin-slice/research.md §2). -->
  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <!-- A project reference carries neither the analyzers nor YAF.Core.props, which an app gets from the YAF.Core package, so both are named
       here (specs/0009-domain/research.md §6). The analyzers stay out of this package: consumers get them through YAF.Core. -->
  <ItemGroup>
    <ProjectReference Include="../Analyzers/Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="../Persistence.EfCore/Persistence.EfCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Persistence.EfCore.PostgreSql.Tests" />
  </ItemGroup>

  <Import Project="../Core/buildTransitive/YAF.Core.props" />

</Project>
