<Project Sdk="Microsoft.NET.Sdk">

  <!-- Empty until the problem details mapper, result mapper, exception handler and JSON options arrive (specs/0013-thin-slice/plan.md,
       T53 on). YafServiceCode core, so that HttpErrors is registered and listed by IErrorCatalogProvider (plan, decision log). No
       IsAotCompatible or IsTrimmable: YAF.Http makes no AOT or trimming claim (01 §4). -->
  <PropertyGroup>
    <YafServiceCode>core</YafServiceCode>
  </PropertyGroup>

  <!-- The ASP.NET Core shared framework, as ADR-0003's row for YAF.Http allows. No HTML sanitizer and no Asp.Versioning: they live in
       YAF.Markup.HtmlSanitizer and YAF.Http.Versioning. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- A project reference carries neither the analyzers nor YAF.Core.props, which an app gets from the YAF.Core package, so both are named
       here (specs/0009-domain/research.md §6). The analyzers stay out of this package: consumers get them through YAF.Core. -->
  <ItemGroup>
    <ProjectReference Include="../Analyzers/Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="../Application/Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Http.Tests" />
  </ItemGroup>

  <Import Project="../Core/buildTransitive/YAF.Core.props" />

</Project>
