<Project Sdk="Microsoft.NET.Sdk">

  <!-- Empty until the endpoint contract and the typed result extensions arrive (specs/0013-thin-slice/plan.md, T57, T58). No
       YafServiceCode: the package declares no error catalogue. No IsAotCompatible or IsTrimmable: it makes no AOT or trimming claim
       (01 §4). -->

  <!-- The ASP.NET Core shared framework, as ADR-0003's row for YAF.Http and the MinimalApis package allows. No HTML sanitizer and no
       Asp.Versioning. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- A project reference carries neither the analyzers nor YAF.Core.props, which an app gets from the YAF.Core package, so both are named
       here (specs/0009-domain/research.md §6). The analyzers stay out of this package: consumers get them through YAF.Core. -->
  <ItemGroup>
    <ProjectReference Include="../Analyzers/Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="../Http/Http.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Http.MinimalApis.Tests" />
  </ItemGroup>

  <Import Project="../Core/buildTransitive/YAF.Core.props" />

</Project>
