<Project Sdk="Microsoft.NET.Sdk">

  <!-- Trim- and AOT-compatible, YAF.Core only (01 §4; plan 0005 deviation 8). -->
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Compliance.Abstractions" />
  </ItemGroup>

  <!-- The analyzers run on YAF.Core itself and ship in its package under analyzers/dotnet/cs (01 §2.1; specs/0006-core/research.md §4). -->
  <ItemGroup>
    <ProjectReference Include="../Analyzers/Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="../Analyzers/bin/$(Configuration)/netstandard2.0/YAF.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="buildTransitive/YAF.Core.props" Pack="true" PackagePath="build;buildTransitive" />
  </ItemGroup>

</Project>
