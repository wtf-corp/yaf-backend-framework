/tests/Architecture.Tests/                 @yaf/maintainers
/src/Analyzers/                            @yaf/maintainers
/Directory.Build.props                     @yaf/maintainers
/Directory.Build.targets                   @yaf/maintainers
/src/Directory.Build.props                 @yaf/maintainers
/nuget.config                              @yaf/maintainers
/global.json                               @yaf/maintainers

# Release
