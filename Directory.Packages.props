<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Test runner (ADR-0018). Latest stable on nuget.org, checked 2026-11-20. -->
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <!-- Build-only analyzers for src/ (01 §4), private assets. Latest stable on nuget.org, checked 2026-11-20. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <!-- YAF.Core's one dependency (02 §2, ADR-0003 allow-list). Latest stable on nuget.org, checked 2026-11-24. -->
    <PackageVersion Include="Microsoft.Extensions.Compliance.Abstractions" Version="11.0.1" />
    <!-- FakeTimeProvider behind YAF.Testing's TestClock, in YAF.Testing only (15 §3, ADR-0018; ADR-0003 row YAF.Testing). Licence MIT
         (nuspec). Latest stable on nuget.org, checked 2026-11-26 (specs/0009-domain/research.md §8). -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.1" />
    <!-- Assertions in test projects (ADR-0018). Latest stable on nuget.org, checked 2026-11-24. -->
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <!-- Roslyn for src/Analyzers (private assets) and tests/Analyzers.Tests (ADR-0003 allow-list). Pinned to 5.0.0, the oldest
         version with every API the generators use, so hosts with an older compiler load them (specs/0006-core/research.md §3). -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <!-- Architecture rules in tests/Architecture.Tests (ADR-0018). Version from specs/0006-core/research.md §10, on nuget.org 2026-11-24. -->
    <PackageVersion Include="TngTech.ArchUnitNET.xUnitV3" Version="0.13.5" />
    <!-- Benchmarks in tests/Benchmarks only, never in a package (ADR-0030). Latest stable on nuget.org, checked 2026-11-24. -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <!-- EF Core in YAF.Persistence.EfCore (ADR-0003 row YAF.Persistence.EfCore). Licence MIT (nuspec). Latest stable on nuget.org,
         checked 2026-11-26 (specs/0013-thin-slice/research.md §2). -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="11.0.0" />
    <!-- Npgsql's EF Core provider in YAF.Persistence.EfCore.PostgreSql (ADR-0003 row YAF.Persistence.EfCore, .PostgreSql). Licence
         PostgreSQL (nuspec). Latest stable on nuget.org, checked 2026-11-26 (specs/0013-thin-slice/research.md §2). -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0" />
    <!-- Design-time EF Core for `dotnet ef` in the sample's infrastructure project, private assets, never in a package (ADR-0003, EF
         Core). Licence MIT (nuspec). Latest stable on nuget.org, checked 2026-11-26 (specs/0013-thin-slice/research.md §2). -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0" />
    <!-- PostgreSQL container in YAF.Testing.Integration (ADR-0003 row YAF.Testing.Integration, Testcontainers). Licence MIT (nuspec).
         Latest stable on nuget.org, checked 2026-11-26 (specs/0013-thin-slice/research.md §2). -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.17.0" />
    <!-- Test host in YAF.Testing.Integration (ADR-0003 row YAF.Testing.Integration, ASP.NET Core test host). Licence MIT (nuspec).
         Latest stable on nuget.org, checked 2026-11-26 (specs/0013-thin-slice/research.md §2). -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
    <!-- Fixtures and collections in YAF.Testing.Integration (ADR-0003 row YAF.Testing.Integration, test framework); the version line of
         xunit.v3 above. Licence Apache-2.0 (nuspec). Latest stable on nuget.org, checked 2026-11-26 (specs/0013-thin-slice/research.md §2). -->
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.3" />
    <!-- Architecture rules in YAF.Testing (15 §3, ADR-0018); ADR-0003 row YAF.Testing, superseded for this package by ADR-0033 (plan
         0013, Q3). Licence Apache-2.0 (nuspec). Latest stable on nuget.org, checked 2026-11-26 (specs/0013-thin-slice/research.md §2). -->
    <PackageVersion Include="TngTech.ArchUnitNET" Version="0.13.5" />
  </ItemGroup>

</Project>
